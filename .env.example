# Copy this file to .env and fill in real values. Never commit .env.
PORT=3000
APP_ENV=local
APP_VERSION=dev

# PostgreSQL connection. Leave empty to use the in-memory store.
# In Docker Compose, the host is the database service name (e.g. "db"), not localhost.
DATABASE_URL=postgres://journey:change-me@localhost:5432/journeylog

# Used by the postgres container in docker-compose.yml
POSTGRES_USER=journey
POSTGRES_PASSWORD=change-me
POSTGRES_DB=journeylog
